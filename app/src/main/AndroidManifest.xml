<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão da câmera -->
    <uses-permission
        android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="mercadinho"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mercadinho">
        <activity
            android:name=".MovimentacaoActivity"
            android:exported="false" />
        <activity
            android:name=".HistoricoMovimentacoesActivity"
            android:exported="false" />
        <activity
            android:name=".ConsultaEstoqueActivity"
            android:exported="false" />
        <activity
            android:name=".EditarProdutoActivity"
            android:exported="false" />
        <activity
            android:name=".NovaVendaActivity"
            android:exported="false" />
        <activity
            android:name=".HistoricoVendasActivity"
            android:exported="false" />

        <!-- Tela inicial -->
        <activity
            android:name=".InicioActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <!-- Tela de estoque e câmera -->
        <activity
            android:name=".EstoqueActivity"
            android:exported="false" />

        <!-- Tela principal temporária -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ClientesActivity"
            android:exported="false" />
        <activity
            android:name=".FiadosClienteActivity"
            android:exported="false" />
    </application>

</manifest>