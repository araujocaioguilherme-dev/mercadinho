<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:text="Movimentação de estoque"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#0C437F"/>

        <!-- CONTEÚDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CÓDIGO DE BARRAS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Código de barras"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:labelFor="@id/edtCodigoMovimentacao"/>

            <EditText
                android:id="@+id/edtCodigoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Digite o código do produto"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <Button

                android:id="@+id/btnBuscarProdutoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Buscar produto"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0C437F"/>

            <!-- PRODUTO ENCONTRADO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Produto selecionado"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtProdutoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:text="Nenhum produto selecionado"
                android:textColor="#17365D"
                android:background="#E8EDF5"/>

            <TextView
                android:id="@+id/txtEstoqueAtualMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="12dp"
                android:text="Estoque atual: --"
                android:textColor="#17365D"
                android:background="#E8EDF5"/>

            <!-- TIPO DE MOVIMENTAÇÃO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tipo de movimentação"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/grupoTipoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:checkedButton="@id/radioEntrada">

                <RadioButton
                    android:id="@+id/radioEntrada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrada"
                    android:textColor="#17365D"
                    android:buttonTint="#087B46"/>

                <RadioButton
                    android:id="@+id/radioSaida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Saída"
                    android:textColor="#17365D"
                    android:buttonTint="#087B46"/>

            </RadioGroup>

            <!-- QUANTIDADE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quantidade"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:labelFor="@id/edtQuantidadeMovimentacao"/>

            <EditText
                android:id="@+id/edtQuantidadeMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex.: 10"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <!-- MOTIVO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Motivo da movimentação"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:labelFor="@id/edtMotivoMovimentacao"/>

            <EditText
                android:id="@+id/edtMotivoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:gravity="top"
                android:padding="12dp"
                android:hint="Ex.: Reposição de mercadoria"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <!-- REGISTRAR -->

            <Button
                android:id="@+id/btnRegistrarMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Registrar movimentação"
                android:textColor="#FFFFFF"
                android:backgroundTint="#087B46"/>

            <!-- CONSULTAR HISTÓRICO -->

            <Button
                android:id="@+id/btnVerHistoricoMovimentacoes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Ver histórico de movimentações"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0C437F"/>

            <!-- CANCELAR -->

            <Button
                android:id="@+id/btnCancelarMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Cancelar"
                android:textColor="#17365D"
                android:backgroundTint="#E3E7EE"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>