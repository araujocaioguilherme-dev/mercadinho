<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:background="@drawable/bg_azul_cabecalho" android:paddingStart="18dp" android:paddingEnd="18dp" android:orientation="horizontal">
        <ImageView android:id="@+id/btnVoltarScanner" android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_voltar" android:contentDescription="Voltar"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Ler código de barras" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_scanner" android:contentDescription="Scanner"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="292dp" android:background="@drawable/bg_camera" android:clipToOutline="true">
                <androidx.camera.view.PreviewView android:id="@+id/viewFinder" android:layout_width="match_parent" android:layout_height="match_parent" app:implementationMode="compatible" app:scaleType="fillCenter"/>
                <View android:layout_width="245dp" android:layout_height="142dp" android:layout_gravity="center" android:background="@drawable/bg_moldura_scan" android:importantForAccessibility="no"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp" android:background="@drawable/bg_legenda_camera" android:padding="12dp" android:text="Aponte para o código de barras do produto" android:textSize="12sp" android:textColor="#FFFFFF"/>
            </FrameLayout>
            <TextView android:id="@+id/txtCodigoLido" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_cartao" android:padding="13dp" android:text="Aguardando leitura do código..." android:textColor="#17345B" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Dados do produto" android:textColor="#142D4F" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:labelFor="@id/edtNomeProduto" android:text="Nome do produto" android:textColor="#334E6B" android:textSize="13sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtNomeProduto" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="5dp" android:background="@drawable/bg_campo" android:hint="Ex.: Coca-Cola 2 L" android:inputType="textCapSentences" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="15sp" android:textColor="#152F53" android:textColorHint="#8A99AC"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/edtQuantidade" android:text="Quantidade" android:textColor="#334E6B" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/edtQuantidade" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="5dp" android:background="@drawable/bg_campo" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="1" android:inputType="number" android:textSize="15sp" android:maxLines="1" android:textColor="#152F53"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/edtPreco" android:text="Preço (R$)" android:textColor="#334E6B" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/edtPreco" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="5dp" android:background="@drawable/bg_campo" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="9.50" android:inputType="numberDecimal" android:textSize="15sp" android:maxLines="1" android:textColor="#152F53" android:textColorHint="#8A99AC"/>
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/btnSalvarEstoque" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="16dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_botao_verde" android:backgroundTint="@null" android:text="Salvar no estoque" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_rodape"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:id="@+id/navInicio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_casa" app:tint="#788AA1" android:contentDescription="Início"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Início" android:textColor="#788AA1" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navVenda" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_carrinho" app:tint="#086FCB" android:contentDescription="Venda"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Venda" android:textColor="#086FCB" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navEstoque" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_caixa" app:tint="#788AA1" android:contentDescription="Estoque"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Estoque" android:textColor="#788AA1" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navMais" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_maisop" app:tint="#788AA1" android:contentDescription="Mais"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Mais" android:textColor="#788AA1" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>