<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- CABEÇALHO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="Histórico de movimentações"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="#0C437F"/>

    <!-- INFORMAÇÕES DO HISTÓRICO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTotalMovimentacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 0 movimentações"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnAtualizarHistorico"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Atualizar histórico"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0C437F"/>

    </LinearLayout>

    <!-- MENSAGEM QUANDO NÃO HOUVER REGISTROS -->

    <TextView
        android:id="@+id/txtHistoricoVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center"
        android:text="Nenhuma movimentação registrada."
        android:textColor="#526173"
        android:textSize="16sp"/>

    <!-- LISTAGEM DAS MOVIMENTAÇÕES -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerHistoricoMovimentacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

    <!-- BOTÃO VOLTAR -->

    <Button
        android:id="@+id/btnVoltarHistorico"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="Voltar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0C437F"/>

</LinearLayout>