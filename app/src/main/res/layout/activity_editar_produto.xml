<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:text="Editar produto"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#0C437F"/>

        <!-- FORMULÁRIO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Código de barras"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtEditarCodigoBarra"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="Código do produto"
                android:textColor="#17365D"
                android:background="#E8EDF5"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nome do produto"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEditarNome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nome do produto"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quantidade disponível"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEditarQuantidade"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Quantidade"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Preço de venda (R$)"
                android:textColor="#17365D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEditarPreco"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="0,00"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="#17365D"
                android:textColorHint="#526173"/>

            <!-- BOTÃO SALVAR -->

            <Button
                android:id="@+id/btnSalvarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Salvar alterações"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#087B46"/>

            <!-- BOTÃO CANCELAR -->

            <Button
                android:id="@+id/btnCancelarEdicao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Cancelar"
                android:textColor="#17365D"
                android:backgroundTint="#E3E7EE"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>